PORT=3000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Ganti dengan connection string Neon lo:
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret & Expiry
JWT_SECRET="super-secret-kilaubuild-jwt-key-2026!@#"
JWT_EXPIRATION="7d"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS Origins (Frontend Next.js)
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"
